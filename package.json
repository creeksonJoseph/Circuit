{
  "name": "circuit",
  "version": "0.1.0",
  "private": true,
  "description": "CIRCUIT — universal multi-party asset exchange protocol on Solana",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/matcher",
    "tests"
  ],
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:sdk": "bash scripts/build-sdk.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:matcher && npm run test:sdk",
    "test:matcher": "npm run test -w @circuit/matcher",
    "test:sdk": "bash scripts/test-sdk.sh",
    "test:integration": "npm run test:integration -w @circuit/tests",
    "lint": "eslint .",
    "format": "prettier --write \"packages/matcher/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mjs}\" \"tsconfig.base.json\"",
    "format:check": "prettier --check \"packages/matcher/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mjs}\" \"tsconfig.base.json\"",
    "clean": "rm -rf target node_modules packages/matcher/dist tests/dist packages/sdk/build packages/sdk/dist"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5"
  }
}
