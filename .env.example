# CIRCUIT public configuration example.
#
# Copy to .env and adjust for your local validator or Devnet deployment.
# NEVER put a private key, seed phrase, or deploy keypair in this file.
# The browser only receives VITE_* variables, and none of them may be secret.

VITE_SOLANA_CLUSTER=localnet
VITE_SOLANA_RPC_URL=http://127.0.0.1:8899
VITE_CIRCUIT_PROGRAM_ID=4Jr3Ptxa7ZnnbYpNcuPDS5AGswBQpGgyqzBHU3h1PNhc

# Python SDK (server-side or script use only; no secrets)
CIRCUIT_RPC_URL=http://127.0.0.1:8899
CIRCUIT_PROGRAM_ID=4Jr3Ptxa7ZnnbYpNcuPDS5AGswBQpGgyqzBHU3h1PNhc

# Devnet example (replace with your own funded wallet outside the repository):
# VITE_SOLANA_CLUSTER=devnet
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
